generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum VendorStatus {
  APPLIED
  DOCUMENTS_PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  TERMINATED

  @@map("vendor_status")
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  ARCHIVED

  @@map("product_status")
}

enum ProductCondition {
  NEW
  USED
  REFURBISHED

  @@map("product_condition")
}

enum ProductVariantStatus {
  ACTIVE
  ARCHIVED

  @@map("product_variant_status")
}

enum ProductApprovalDecision {
  AUTO_APPROVED
  PENDING_REVIEW
  APPROVED
  REJECTED

  @@map("product_approval_decision")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  COD_CONFIRMED
  PROCESSING
  PARTIALLY_SHIPPED
  SHIPPED
  PARTIALLY_DELIVERED
  DELIVERED
  COMPLETED
  CANCELLED
  FAILED_PAYMENT
  REFUND_PENDING
  REFUNDED
  PARTIALLY_REFUNDED

  @@map("order_status")
}

enum ShipmentStatus {
  PENDING
  PACKED
  HANDED_TO_CARRIER
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RETURNING
  RETURNED
  LOST

  @@map("shipment_status")
}

enum StockReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED

  @@map("stock_reservation_status")
}

enum ShippingRateType {
  FLAT
  FREE_OVER_THRESHOLD
  WEIGHT_BASED

  @@map("shipping_rate_type")
}

enum TaxTreatment {
  INCLUSIVE
  EXCLUSIVE

  @@map("tax_treatment")
}

model Vendor {
  id          String           @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  displayName String           @map("display_name") @db.VarChar(160)
  status      VendorStatus     @default(APPLIED)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?        @map("deleted_at") @db.Timestamptz(6)
  products    Product[]
  variants    ProductVariant[]
  orderItems  OrderItem[]
  shipments   Shipment[]
  shippingProfiles ShippingProfile[]

  @@index([status])
  @@map("vendors")
}

model Category {
  id                       String     @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  parentId                 String?    @map("parent_id") @db.Uuid
  name                     String     @db.VarChar(120)
  slug                     String     @unique @db.VarChar(140)
  description              String?
  taxClass                 String?    @map("tax_class") @db.VarChar(50)
  commissionOverrideBps    Int?       @map("commission_override_bps")
  returnWindowOverrideDays Int?       @map("return_window_override_days")
  isRestricted             Boolean    @default(false) @map("is_restricted")
  isAgeRestricted          Boolean    @default(false) @map("is_age_restricted")
  isActive                 Boolean    @default(true) @map("is_active")
  displayOrder             Int        @default(0) @map("display_order")
  createdAt                DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  parent                   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children                 Category[] @relation("CategoryTree")
  products                 Product[]

  @@index([parentId, displayOrder])
  @@index([isActive, displayOrder])
  @@map("categories")
}

model ShippingProfile {
  id           String         @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  vendorId     String         @map("vendor_id") @db.Uuid
  name         String         @db.VarChar(120)
  carrierName  String         @map("carrier_name") @db.VarChar(100)
  shippingTaxClass String     @map("shipping_tax_class") @db.VarChar(50)
  handlingDays Int            @map("handling_days")
  transitDays  Int            @map("transit_days")
  codAllowed   Boolean        @default(false) @map("cod_allowed")
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  vendor       Vendor         @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  zones        ShippingZone[]

  @@unique([vendorId, name])
  @@index([vendorId, isActive])
  @@map("shipping_profiles")
}

model ShippingZone {
  id                String          @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  shippingProfileId String          @map("shipping_profile_id") @db.Uuid
  province          String          @db.VarChar(100)
  city              String          @db.VarChar(100)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  profile           ShippingProfile @relation(fields: [shippingProfileId], references: [id], onDelete: Cascade)
  rate              ShippingRate?

  @@unique([shippingProfileId, province, city])
  @@index([province, city])
  @@map("shipping_zones")
}

model ShippingRate {
  id                  String           @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  shippingZoneId      String           @unique @map("shipping_zone_id") @db.Uuid
  type                ShippingRateType
  amount              BigInt?
  freeAboveAmount     BigInt?          @map("free_above_amount")
  baseAmount          BigInt?          @map("base_amount")
  amountPerKilogram   BigInt?          @map("amount_per_kilogram")
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  zone                ShippingZone     @relation(fields: [shippingZoneId], references: [id], onDelete: Cascade)

  @@map("shipping_rates")
}

model TaxRate {
  id          String       @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  countryCode String       @map("country_code") @db.Char(2)
  province    String       @db.VarChar(100)
  taxClass    String       @map("tax_class") @db.VarChar(50)
  rateBps     Int          @map("rate_bps")
  treatment   TaxTreatment
  isActive    Boolean      @default(true) @map("is_active")
  validFrom   DateTime     @default(now()) @map("valid_from") @db.Timestamptz(6)
  validUntil  DateTime?    @map("valid_until") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([countryCode, province, taxClass, validFrom])
  @@index([countryCode, province, taxClass, isActive, validFrom])
  @@map("tax_rates")
}

model Brand {
  id          String    @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  name        String    @db.VarChar(120)
  slug        String    @unique @db.VarChar(140)
  description String?
  isUnbranded Boolean   @default(false) @map("is_unbranded")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  products    Product[]

  @@index([isActive, name])
  @@map("brands")
}

model Product {
  id              String            @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  vendorId        String            @map("vendor_id") @db.Uuid
  categoryId      String            @map("category_id") @db.Uuid
  brandId         String?           @map("brand_id") @db.Uuid
  title           String            @db.VarChar(150)
  slug            String            @unique @db.VarChar(180)
  description     String?
  searchDocument Unsupported("tsvector")? @map("search_document")
  status          ProductStatus     @default(DRAFT)
  approvalStatus  ProductApprovalDecision @default(PENDING_REVIEW) @map("approval_status")
  condition       ProductCondition  @default(NEW)
  countryOfOrigin String?           @map("country_of_origin") @db.Char(2)
  weightGrams     Int?              @map("weight_grams")
  lengthCm        Decimal?          @map("length_cm") @db.Decimal(8, 2)
  widthCm         Decimal?          @map("width_cm") @db.Decimal(8, 2)
  heightCm        Decimal?          @map("height_cm") @db.Decimal(8, 2)
  createdBy       String?           @map("created_by") @db.Uuid
  updatedBy       String?           @map("updated_by") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamptz(6)
  vendor          Vendor            @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  category        Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand           Brand?            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  variants        ProductVariant[]
  images          ProductImage[]
  approvals       ProductApproval[]

  @@unique([id, vendorId])
  @@index([vendorId, status, createdAt(sort: Desc)])
  @@index([categoryId, status, createdAt(sort: Desc)])
  @@index([brandId, status])
  @@map("products")
}

model ProductApproval {
  id         String                  @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  productId  String                  @map("product_id") @db.Uuid
  reviewerId String?                 @map("reviewer_id") @db.Uuid
  decision   ProductApprovalDecision
  reason     String?                 @db.VarChar(1000)
  createdAt  DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  product    Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt(sort: Desc)])
  @@map("product_approvals")
}

model ProductVariant {
  id             String               @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  productId      String               @map("product_id") @db.Uuid
  vendorId       String               @map("vendor_id") @db.Uuid
  sku            String               @db.VarChar(100)
  status         ProductVariantStatus @default(ACTIVE)
  price          BigInt
  compareAtPrice BigInt?              @map("compare_at_price")
  currency       String               @default("PKR") @db.Char(3)
  stock          Int                  @default(0)
  gtin           String?              @db.VarChar(14)
  weightGrams    Int?                 @map("weight_grams")
  lengthCm       Decimal?             @map("length_cm") @db.Decimal(8, 2)
  widthCm        Decimal?             @map("width_cm") @db.Decimal(8, 2)
  heightCm       Decimal?             @map("height_cm") @db.Decimal(8, 2)
  optionValues   Json?                @map("option_values") @db.JsonB
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?            @map("deleted_at") @db.Timestamptz(6)
  product        Product              @relation(fields: [productId, vendorId], references: [id, vendorId], onDelete: Restrict)
  vendor         Vendor               @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  images         ProductImage[]       @relation("VariantImages")
  cartItems      CartItem[]
  orderItems     OrderItem[]
  reservations   StockReservation[]

  @@unique([vendorId, sku])
  @@unique([productId, id])
  @@index([productId, status])
  @@index([vendorId, status])
  @@map("product_variants")
}

model Cart {
  id        String     @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  sessionId String     @unique @map("session_id") @db.Uuid
  expiresAt DateTime   @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  items     CartItem[]
  checkoutQuotes CheckoutQuote[]

  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id               String        @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  cartId           String        @map("cart_id") @db.Uuid
  productVariantId String        @map("product_variant_id") @db.Uuid
  quantity         Int
  unitPrice        BigInt        @map("unit_price")
  currency         String        @db.Char(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  cart             Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@unique([cartId, productVariantId])
  @@index([cartId, createdAt])
  @@map("cart_items")
}

model CheckoutQuote {
  id           String   @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  cartId       String   @map("cart_id") @db.Uuid
  requestHash  String   @map("request_hash") @db.VarChar(64)
  snapshot     Json     @db.JsonB
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  cart         Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@index([cartId, expiresAt])
  @@index([expiresAt])
  @@map("checkout_quotes")
}

model OrderNumberCounter {
  period    String @id @db.Char(4)
  nextValue BigInt @default(1) @map("next_value")

  @@map("order_number_counters")
}

model Order {
  id                    String      @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  orderNumber           String      @unique @map("order_number") @db.VarChar(20)
  trackingTokenHash     String?     @unique @map("tracking_token_hash") @db.Char(64)
  buyerEmail            String      @map("buyer_email") @db.VarChar(254)
  buyerPhone            String      @map("buyer_phone") @db.VarChar(30)
  recipientName         String      @map("recipient_name") @db.VarChar(160)
  shippingAddressLine1  String      @map("shipping_address_line1") @db.VarChar(200)
  shippingAddressLine2  String?     @map("shipping_address_line2") @db.VarChar(200)
  shippingCity          String      @map("shipping_city") @db.VarChar(100)
  shippingProvince      String      @map("shipping_province") @db.VarChar(100)
  shippingPostalCode    String?     @map("shipping_postal_code") @db.VarChar(20)
  shippingCountryCode   String      @default("PK") @map("shipping_country_code") @db.Char(2)
  currency              String      @default("PKR") @db.Char(3)
  subtotal              BigInt
  shippingTotal         BigInt      @default(0) @map("shipping_total")
  taxTotal              BigInt      @default(0) @map("tax_total")
  total                 BigInt
  status                OrderStatus @default(PENDING_PAYMENT)
  version               Int         @default(1)
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  items                 OrderItem[]
  shipments             Shipment[]
  reservations          StockReservation[]
  statusHistory         OrderStatusHistory[]

  @@index([status, createdAt(sort: Desc)])
  @@map("orders")
}

model Shipment {
  id            String         @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  orderId       String         @map("order_id") @db.Uuid
  vendorId      String         @map("vendor_id") @db.Uuid
  status        ShipmentStatus @default(PENDING)
  shippingAmount BigInt        @default(0) @map("shipping_amount")
  taxAmount      BigInt         @default(0) @map("tax_amount")
  currency       String         @default("PKR") @db.Char(3)
  trackingNumber String?       @map("tracking_number") @db.VarChar(100)
  carrier       String?        @db.VarChar(100)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  vendor        Vendor         @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  @@unique([orderId, vendorId])
  @@unique([orderId, id, vendorId])
  @@index([vendorId, status, createdAt(sort: Desc)])
  @@map("shipments")
}

model OrderItem {
  id               String         @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  orderId          String         @map("order_id") @db.Uuid
  shipmentId       String         @map("shipment_id") @db.Uuid
  vendorId         String         @map("vendor_id") @db.Uuid
  productVariantId String         @map("product_variant_id") @db.Uuid
  productTitle     String         @map("product_title") @db.VarChar(150)
  variantSku       String         @map("variant_sku") @db.VarChar(100)
  quantity         Int
  unitPrice        BigInt         @map("unit_price")
  taxAmount        BigInt         @default(0) @map("tax_amount")
  currency         String         @db.Char(3)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shipment         Shipment       @relation(fields: [orderId, shipmentId, vendorId], references: [orderId, id, vendorId], onDelete: Restrict)
  vendor           Vendor         @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@unique([orderId, productVariantId])
  @@index([orderId, shipmentId, vendorId])
  @@index([vendorId, createdAt(sort: Desc)])
  @@map("order_items")
}

model StockReservation {
  id               String                 @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  orderId          String                 @map("order_id") @db.Uuid
  productVariantId String                 @map("product_variant_id") @db.Uuid
  quantity         Int
  status           StockReservationStatus @default(ACTIVE)
  expiresAt        DateTime               @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  order            Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productVariant   ProductVariant         @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@unique([orderId, productVariantId])
  @@index([productVariantId])
  @@index([status, expiresAt])
  @@map("stock_reservations")
}

model OrderStatusHistory {
  id             String         @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  orderId        String?        @map("order_id") @db.Uuid
  shipmentId     String?        @map("shipment_id") @db.Uuid
  orderStatus    OrderStatus?   @map("order_status")
  shipmentStatus ShipmentStatus? @map("shipment_status")
  actorId        String?        @map("actor_id") @db.Uuid
  reason         String?        @db.VarChar(500)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  order          Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shipment       Shipment?      @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([shipmentId, createdAt])
  @@map("order_status_history")
}

model IdempotencyKey {
  id          String   @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  key         String   @db.VarChar(100)
  endpoint    String   @db.VarChar(200)
  requestHash String   @map("request_hash") @db.VarChar(64)
  response    Json     @db.JsonB
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([endpoint, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model ProductImage {
  id               String          @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  productId        String          @map("product_id") @db.Uuid
  productVariantId String?         @map("product_variant_id") @db.Uuid
  storagePath      String          @unique @map("storage_path") @db.VarChar(1024)
  altText          String?         @map("alt_text") @db.VarChar(250)
  mimeType         String          @map("mime_type") @db.VarChar(50)
  byteSize         Int             @map("byte_size")
  width            Int
  height           Int
  isPrimary        Boolean         @default(false) @map("is_primary")
  displayOrder     Int             @default(0) @map("display_order")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant          ProductVariant? @relation("VariantImages", fields: [productId, productVariantId], references: [productId, id], onDelete: Restrict)

  @@index([productId, displayOrder])
  @@map("product_images")
}
