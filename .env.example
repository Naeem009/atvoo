# Supabase PostgreSQL transaction pooler for API/runtime connections.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true

# Supabase session pooler or direct connection for Prisma migrations.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

# Used by backend integrations such as Supabase Storage; never expose service keys to the web.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_PRODUCT_MEDIA=product-media

# Browser origins allowed to call the API; use deployed storefront domains in production.
CORS_ORIGIN=http://localhost:3000

# Server-side catalog API base URL; do not expose database credentials to the web app.
API_BASE_URL=http://localhost:3001/api/v1
APP_URL=http://localhost:3000

# Optional public social profile URLs; only valid HTTPS profile URLs are shown.
NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=
NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=
NEXT_PUBLIC_SOCIAL_TIKTOK_URL=
NEXT_PUBLIC_SOCIAL_PINTEREST_URL=
NEXT_PUBLIC_SOCIAL_X_URL=
