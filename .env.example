# Supabase PostgreSQL transaction pooler for API/runtime connections.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true

# Supabase session pooler or direct connection for Prisma migrations.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

# Used by backend integrations such as Supabase Storage; never expose service keys to the web.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
